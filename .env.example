# Copie este arquivo para .env e preencha a chave (o .env NAO vai para o Git).

# Chave da API da NVIDIA (https://build.nvidia.com)
# Usada para embeddings (E2, bloco C) e para o LLM GPT-OSS-20B (E3)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelos
# nv-embedqa-e5-v5 foi descontinuado pela NVIDIA em 25/08/2026
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# o modelo gera 2048 dimensoes; o indice HNSW do pgvector aceita no maximo 2000
EMBEDDING_DIM=1024
LLM_MODEL=openai/gpt-oss-20b

AGENT_DB_USER=agente_leitura
AGENT_DB_PASSWORD=
